# ─────────────────────────────────────────────────────────────
# RepoMatch backend — copy to .env and adjust.
#   cp .env.example .env
# .env is gitignored. Never commit real tokens.
# ─────────────────────────────────────────────────────────────

# Port the Express server listens on.
PORT=3000

# GitHub personal access token — OPTIONAL but strongly recommended.
# Leave EMPTY to run fully anonymous (works, but only ~10 search
# requests/minute and 60 requests/hour, and RepoMatch will silently fall
# back to demo data once you run out).
#   Create one: https://github.com/settings/tokens
#   Public repo read scope is enough.
GITHUB_TOKEN=

# Ollama base URL. Do not include a trailing slash.
# The model must be installed locally:  ollama pull gemma4:e2b
OLLAMA_URL=http://localhost:11434

# Optional overrides (rarely needed).
# GEMMA_MODEL=gemma4:e2b
# CORS_ORIGINS=http://localhost:5173
